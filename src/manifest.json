{
    "manifest_version": 3,
    
    "name": "Filtering Extension",
    "version": "0.1",
    "description": "Allows to filter and sort lists on websites using custom setting",
    
    "icons": {

    },

    "permissions": ["activeTab", "tabs", "scripting", "storage"],

    "action": {

        "default_popup": ["popup/popup.html","popup/popup.js"]
    },
    "content_scripts": [
        {
            "matches": ["*://*/*"],
            "js": ["content/content.js"],
            "css": ["content/content.css"]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["utils/utils.js","utils/browser_utils.js","createElementShortcuts.js"],
            "matches": ["*://*/*"]
        }
    ]
}