{
    "manifest_version": 3,
    
    "name": "Filtering Extension",
    "version": "0.1",
    "description": "Allows to filter and sort lists on websites using custom setting",
    
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "permissions": ["storage", "scripting", "activeTab"],
    "optional_host_permissions": ["*://*/*"],

    "action": {
        "default_title": "Kliknij, aby przefiltrować"
    },

    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    
    "web_accessible_resources": [
        {
            "resources": ["*"],
            "matches": ["*://*/*"]
        }
    ]
}